    LTEXT           "2LabVnc Server for Windows",IDC_STATIC,107,12,189,10
    LTEXT           "Version unknown, build time unknown",IDC_STATIC_VERSION,107,20,189,10
    LTEXT           "Copyright (C) 2026 2lab snc.\nBased on TightVNC 2.x by GlavSoft LLC.",IDC_STATIC,107,38,189,18
    LTEXT           "",IDC_STATIC_LICENSING,107,64,189,10
    LTEXT           "2LabVnc is an independent GPLv2 fork of TightVNC 2.x.\nIt adds mandatory AES-256-GCM transport encryption with ECDH P-256 and PBKDF2-HMAC-SHA-256 authentication.",IDC_STATIC,13,81,283,26
    DEFPUSHBUTTON   "Visit the Web Site",IDC_VISIT_WEB_SITE_BUTTON,7,116,94,15,WS_GROUP
    PUSHBUTTON      "Project and License",IDC_ORDER_SUPPORT_BUTTON,107,116,94,15
    PUSHBUTTON      "Close This Window",IDCANCEL,207,116,94,15
END

