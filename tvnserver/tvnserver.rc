    EDITTEXT        IDC_DISPATCH_KEYWORD,185,89,71,12,ES_AUTOHSCROLL | NOT WS_VISIBLE | WS_GROUP
    DEFPUSHBUTTON   "&Attach",IDOK,75,101,50,15,WS_GROUP
    PUSHBUTTON      "&Cancel",IDCANCEL,132,101,50,15
END

