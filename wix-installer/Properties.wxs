    <!-- Components to install above properties -->
    <DirectoryRef Id="TARGETDIR" DiskId="1">
  <?ifndef SERVER_FREE ?>
      <Component Id='SetServiceOnly' Feature='Server' Guid='{3561840F-8319-4174-8176-C697A96183CD}' Permanent='yes'>
	<RegistryKey Root="HKLM" 
	  Key='Software\2Lab\2LabVnc\Server\ServiceOnly' 
	  ForceCreateOnInstall='yes'
	  ForceDeleteOnUninstall='yes'>
          <Permission GenericAll='yes' User='System'/>
          <Permission GenericAll='yes' User='Administrators'/>
          <Permission Read="yes" GenericRead="yes"
                 ReadPermission="yes" Synchronize="yes"
                 GenericWrite="no"
		 User='[WIX_ACCOUNT_USERS]'/>
        </RegistryKey>
        <Condition> 
        	SERVICE_ONLY = 1 AND <![CDATA[IS_SILENT <> 1]]> OR
	        SERVER_SERVICE_ONLY = 1 AND IS_SILENT = 1
	</Condition>
      </Component>
      <Component Id='UnsetServiceOnly' Feature='Server' Guid='{531DFCF9-CE14-47E0-9815-F3D5B4437299}' Permanent='yes'>
	<RemoveRegistryKey Root="HKLM" Key='Software\2Lab\2LabVnc\Server\ServiceOnly' Action="removeOnInstall">
	</RemoveRegistryKey>
        <Condition>
        	NOT SERVICE_ONLY AND <![CDATA[IS_SILENT <> 1]]> OR
	        <![CDATA[SERVER_SERVICE_ONLY <> 1]]> AND IS_SILENT = 1
	</Condition>
      </Component>

