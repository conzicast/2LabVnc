<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <Feature Id='ProductFeature'
             Title='2LabVnc'
             Description='Windows 7 or later only. Choose the AES-256-GCM encrypted Server, Viewer, or both.'
             Display='expand'
             Level='1'
             ConfigurableDirectory='INSTALLDIR'>
      <?ifndef SERVER_FREE ?>
      <Feature Id='Server'
               Title='2LabVnc Server'
               Description='Encrypted server, Windows service, tray control and Start menu tools.'
               Level='1'>
        <ComponentRef Id='ServerExe' />
        <ComponentRef Id='SasDll' />
        <ComponentRef Id='ProgramMenuDir' />
        <ComponentRef Id='ServerMenuDir' />
        <ComponentRef Id='ServiceMenuDir' />
        <ComponentRef Id='tvnserverFirewallException'/>
        <ComponentRef Id='LogFolderPermissions'/>
      </Feature>
      <?endif?>
      <?ifndef VIEWER_FREE ?>
      <Feature Id='Viewer'
               Title='2LabVnc Viewer'
               Description='Viewer for encrypted 2LabVnc servers.'
               Level='1'>
        <ComponentRef Id='ProgramMenuDir' />
        <ComponentRef Id='ViewerExe' />
        <ComponentRef Id='ViewerFileAssoc' />
        <ComponentRef Id='LogFolderPermissions'/>
      </Feature>
      <?endif?>
      <!-- Always installing component -->
        <ComponentRef Id='ProgramMenuDir' />
      <ComponentRef Id='LicenseFileComponent'/>
    </Feature>
  </Fragment>
</Wix>
